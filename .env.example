# AliExpress API Credentials
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=

# Callback URL used in AliExpress App Console
# Note: Ensure this matches the callback URL you provide in the AliExpress developer console.
# For local dev preview, use: https://ais-dev-ukx2jg7ld5t5e7mekjbfah-110487595548.us-west2.run.app/api/aliexpress/callback
ALIEXPRESS_CALLBACK_URL=

# Reddit Conversions API (server-side events)
# Ads API access token with the pixel's account scope. Without it the
# /api/reddit/conversion route no-ops and only the browser pixel fires.
REDDIT_CONVERSIONS_ACCESS_TOKEN=
# Optional overrides
REDDIT_PIXEL_ID=a2_jfpt0cc0tbxd
REDDIT_CONVERSIONS_TEST_MODE=false
