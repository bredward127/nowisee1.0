# AliExpress API Credentials
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=

# Callback URL used in AliExpress App Console
# Note: Ensure this matches the callback URL you provide in the AliExpress developer console.
# For local dev preview, use: https://ais-dev-ukx2jg7ld5t5e7mekjbfah-110487595548.us-west2.run.app/api/aliexpress/callback
ALIEXPRESS_CALLBACK_URL=

# PayPal — Client ID of a LIVE REST app from
# developer.paypal.com -> Apps & Credentials -> Live -> your app.
# ~80 characters, starts with "A". This is inlined into the browser bundle
# (that is expected and safe). NEVER put the app Secret in a VITE_* variable.
# A "BAA..." id from the no-code Payment Buttons tool will NOT work here.
VITE_PAYPAL_CLIENT_ID=
